# ==========================================
# Deletion Audit Agent - Environment Configuration
# Copy to .env and fill in values. Never commit .env.
# ==========================================

# Model Provider Configuration
# Choose from: qwen, gemini, openai, anthropic
DEFAULT_MODEL_PROVIDER=qwen

# ------------------------------------------
# QwenCloud (Alibaba Cloud Model Studio / DashScope) - primary agent model
# Get an API key:   https://home.qwencloud.com/
# Docs (API key):   https://www.alibabacloud.com/help/en/model-studio/get-api-key
# OpenAI-compatible endpoint; pick the base URL for your account's region:
#   International (Singapore): https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   US (Virginia):             https://dashscope-us.aliyuncs.com/compatible-mode/v1
#   China (Beijing):           https://dashscope.aliyuncs.com/compatible-mode/v1
# Confirm available model IDs in the QwenCloud console before running.
# ------------------------------------------
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_VISION_MODEL=qwen-vl-plus

# Other providers (optional)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model Names
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Multimodal & Vision Model Configuration
# Choose from: qwen, gemini, openai, anthropic
VISION_MODEL_PROVIDER=qwen
VISION_MODEL=qwen-vl-plus

# Caching & Processing Options
# Set to 'true' to use disk cached multimodal extractions and intent classifications
USE_CACHE=true
CACHE_DIR=code/cache

# Log Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
