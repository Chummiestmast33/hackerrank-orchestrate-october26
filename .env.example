# ==========================================
# Deletion Audit Agent - Environment Configuration
# ==========================================

# Model Provider Configuration
# Choose from: gemini, openai, anthropic
DEFAULT_MODEL_PROVIDER=gemini

# API Keys (Never commit actual keys to version control!)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model Names
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Multimodal & Vision Model Configuration
VISION_MODEL_PROVIDER=gemini
VISION_MODEL=gemini-2.5-flash

# Caching & Processing Options
# Set to 'true' to use disk cached multimodal extractions and intent classifications
USE_CACHE=true
CACHE_DIR=code/cache

# Log Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
