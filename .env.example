# ==========================================
# Deletion Audit Agent - Environment Configuration
# Copy to .env and fill in values. Never commit .env.
# Note: Default offline execution (0 model calls) requires no API keys.
# ==========================================

# QwenCloud / DashScope (Alibaba Cloud Model Studio)
# Only required if re-running one-time multimodal extraction with --extract-images
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen3-vl-plus
QWEN_VISION_MODEL_PASS_B=deepseek-v4.1-flash

# Optional Paths
DELETION_AUDIT_PRICING_JSON=.pricing.json
# DELETION_AUDIT_REPORT_DIR=evaluation
